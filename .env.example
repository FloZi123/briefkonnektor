# Zugriff auf den MCP-Server: Bearer-Token je Kunde, Format key:kundenname,key2:kunde2
# Beispiel-Token lässt sich mit `openssl rand -hex 24` erzeugen.
API_KEYS=dev-token-change-me:lokal

# Carrier: "mock" (kein Versand, nur Simulation) oder "pingen"
CARRIER=mock

# Pingen (https://app.pingen.com → Einstellungen → API)
PINGEN_CLIENT_ID=
PINGEN_CLIENT_SECRET=
PINGEN_ORGANISATION_ID=
# staging = Testumgebung ohne echten Versand, production = echter Versand
PINGEN_ENV=staging

# Server
PORT=3000
# optional: OAuth-Scope (leer = Standard der Client-Credentials)
PINGEN_SCOPE=
# Signing-Key des bei Pingen registrierten Webhooks (POST /organisations/{org}/webhooks, url = https://<domain>/webhooks/pingen)
PINGEN_WEBHOOK_SIGNING_KEY=
