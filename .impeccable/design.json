  "narrative": {
    "northStar": "Das Blatt auf dem Tisch",
    "overview": "Flinkbrief zeigt sein Produkt als das, was es ist: ein Blatt Papier. Seiten liegen als weiße Blätter auf kühlem Papiergrau, und das Einzige, was schmückt, ist ein gelber Textmarker.",
    "keyCharacteristics": [
      "Papier als Material",
      "Marker-Gelb als einziger Schmuck",
      "Ein Markenblau, eine Primärhandlung pro Ansicht",
      "Frist in Orange",
      "Light und Dark gleichwertig"
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Pro Ansicht genau eine Fläche in flink.",
        "section": "colors"
      },
      {
        "name": "The Real State Rule",
        "body": "Grün, Orange und Rot nur für echte Zustände.",
        "section": "colors"
      },
      {
        "name": "The Marker Rule",
        "body": "Gelb markiert Inhalt, nie Flächen, Buttons oder Rahmen.",
        "section": "colors"
      },
      {
        "name": "The 14px Floor Rule",
        "body": "Lesetext mindestens 14px, Hilfstext 13px; Ausnahme Demo-Blatt.",
        "section": "typography"
      },
      {
        "name": "The Paper Only Rule",
        "body": "Nur Papier wirft Schatten.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do nur Tokens aus globals.css verwenden",
      "Do genau eine flink-Fläche pro Ansicht",
