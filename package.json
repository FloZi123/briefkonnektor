{
  "name": "briefkonnektor",
  "version": "0.1.0",
  "private": true,
  "description": "MCP-Konnektor für den Briefversand – Claude schreibt, wir drucken und versenden.",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "npm run typecheck && tsx test/client.ts && tsx test/pingen.ts && tsx test/render.ts",
    "pingen:check": "tsx test/pingen-live.ts",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "express": "^4.21.2",
    "pdf-lib": "^1.17.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
