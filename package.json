{
  "name": "briefkonnektor",
  "version": "0.1.0",
  "private": true,
  "description": "MCP-Konnektor für den Briefversand – Claude schreibt, wir drucken und versenden.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/server.js",
    "test": "npm run build && node dist/test/client.js && node dist/test/pingen.js",
    "pingen:check": "npm run build && node dist/test/pingen-live.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^4.21.2",
    "pdf-lib": "^1.17.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": { "node": ">=20" }
}
