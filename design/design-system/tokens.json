          { "name": "body-strong", "fontSize": "16px", "lineHeight": "1.55", "fontWeight": 600, "sample": "Frist: 16.11.2026", "usage": "Hervorhebung im Fließtext, Button-Beschriftung." },
          { "name": "small", "fontSize": "14px", "lineHeight": "1.5", "fontWeight": 400, "sample": "Preise inkl. MwSt.", "usage": "Hilfetexte, Fußnoten, Tabellen." },
          { "name": "label", "fontSize": "12px", "lineHeight": "1.3", "fontWeight": 600, "letterSpacing": "0.06em", "sample": "AKTENZEICHEN", "usage": "Feldbeschriftungen in Versalien, Eyebrows." }
        ]
      },
      {
        "name": "Daten",
        "family": "mono",
        "styles": [
          { "name": "mono", "fontSize": "14px", "lineHeight": "1.5", "fontWeight": 500, "sample": "12345BG0012345", "usage": "Aktenzeichen, Sendungsnummern, Preise in Tabellen, Schritt-Zähler." }
        ]
      }
    ]
  },
