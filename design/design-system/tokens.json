      { "name": "shadow-card", "value": { "light": "0 1px 2px rgba(22,32,58,0.06), 0 8px 24px rgba(22,32,58,0.08)", "dark": "0 1px 2px rgba(0,0,0,0.4), 0 8px 24px rgba(0,0,0,0.5)" }, "usage": "Nur für die Briefvorschau und schwebende Elemente. Karten im Fluss bekommen Rahmen, keinen Schatten." }
