      { "name": "fehler-soft", "value": { "light": "#fde8e8", "dark": "#3f1d1d" }, "usage": "Hintergrund für Fehlerzustände." },
      { "name": "focus", "value": { "light": "#2f5bea", "dark": "#9fb4ff" }, "usage": "Fokusring, 2px außen, auf allen Bedienelementen." }
