      { "name": "frist", "value": { "light": "#c2410c", "dark": "#fb923c" }, "usage": "Frist, Warnung, Handlungsbedarf. Orange statt Rot, damit es nicht nach Fehler aussieht." },
      { "name": "frist-soft", "value": { "light": "#fdebe1", "dark": "#42281a" }, "usage": "Hintergrund der Fristbox." },
